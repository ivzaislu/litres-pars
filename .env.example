# Northflank runtime variables.
# DATABASE_URL should be an alias of the PostgreSQL addon's POSTGRES_URI.
DATABASE_URL=postgresql://user:password@host:5432/database

# Generate a long random value. Never commit the real secret.
LITRES_APP_TOKEN=change-me

# Seven days. Change server-side only.
LITRES_CACHE_TTL_SECONDS=604800

# Optional local-development fallback only:
# LITRES_DB_PATH=litres-aggregator.sqlite3
